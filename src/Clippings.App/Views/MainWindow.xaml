<Window x:Class="Clippings.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clippings 剪貼簿"
        Width="1120"
        Height="740"
        MinWidth="920"
        MinHeight="620"
        Background="{DynamicResource AppBackgroundBrush}"
        Icon="/Assets/clippings.ico"
        WindowStartupLocation="CenterScreen"
        Loaded="OnLoaded"
        SourceInitialized="OnSourceInitialized"
        Closed="OnClosed"
        Closing="OnClosing"
        PreviewKeyDown="OnPreviewKeyDown">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel Margin="16,18,16,16">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,22">
                    <Image Source="{StaticResource ClippingsMarkImage}"
                           Width="32"
                           Height="32"
                           Stretch="Uniform"
                           UseLayoutRounding="True"
                           SnapsToDevicePixels="True"
                           VerticalAlignment="Center" />
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Clippings" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="剪貼簿" Style="{StaticResource CaptionStyle}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <Border Style="{StaticResource CardBorderStyle}" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="快速擷取" Style="{StaticResource SectionTitleStyle}" FontSize="13" />
                             <Button Content="區域擷取"
                                     Style="{StaticResource PrimaryButtonStyle}"
                                     Margin="0,8,0,0"
                                     Tag="Region"
                                     Click="OnCaptureClick" />
                            <UniformGrid Columns="2" Margin="0,6,0,0">
                                <Button Content="全螢幕"
                                        Style="{StaticResource IconButtonStyle}"
                                        Tag="FullScreen"
                                        Click="OnCaptureClick" />
                                <Button Content="目前螢幕"
                                        Style="{StaticResource IconButtonStyle}"
                                        Tag="Monitor"
                                        Click="OnCaptureClick" />
                                <Button Content="目前視窗"
                                        Style="{StaticResource IconButtonStyle}"
                                        Tag="Window"
                                        Click="OnCaptureClick" />
                                <Button Content="延遲"
                                        Style="{StaticResource IconButtonStyle}"
                                        Tag="Delayed"
                                        Click="OnCaptureClick" />
                            </UniformGrid>
                             <TextBlock x:Name="HotkeyHint"
                                        Style="{StaticResource CaptionStyle}"
                                        Margin="0,6,0,0"
                                        TextWrapping="Wrap" />
                            <TextBlock x:Name="HotkeyWarning"
                                       Foreground="{DynamicResource DangerBrush}"
                                       FontSize="12"
                                       Margin="0,5,0,0"
                                       TextWrapping="Wrap"
                                       Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="VersionText" Style="{StaticResource CaptionStyle}" Margin="4,0,0,0" />
                </StackPanel>

                <ListBox x:Name="NavList"
                         SelectionChanged="OnNavSelectionChanged"
                         Background="Transparent"
                         BorderThickness="0">
                    <ListBoxItem Content="最近擷取" Style="{StaticResource NavItemStyle}" />
                    <ListBoxItem Content="剪貼簿歷史" Style="{StaticResource NavItemStyle}" />
                    <ListBoxItem Content="設定" Style="{StaticResource NavItemStyle}" />
                </ListBox>
            </DockPanel>
        </Border>

        <ContentControl x:Name="ContentHost" Grid.Column="1" Margin="24,20,24,20" />
    </Grid>
</Window>

