<UserControl x:Class="Clippings.App.Views.ClipboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:Clippings.App.Helpers"
             xmlns:strings="clr-namespace:Clippings.App.Strings">

    <UserControl.Resources>
        <helpers:PathToImageConverter x:Key="PathToImage" />
        <Style x:Key="ClipboardCardListItemStyle"
               TargetType="ListBoxItem"
               BasedOn="{StaticResource CardListItemStyle}">
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="剪貼簿歷史" Style="{StaticResource PageTitleStyle}" />
                    <Border Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="9,2"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="CountText" Style="{StaticResource CaptionStyle}" />
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            DockPanel.Dock="Right"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button Content="{x:Static strings:AppStrings.ActionRefresh}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,8,0"
                            Click="OnRefreshClick" />
                    <Button x:Name="ClearButton"
                            Content="清除未釘選"
                            ToolTip="清除未釘選的剪貼簿歷史，釘選項目會保留"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="OnClearClick" />
                </StackPanel>
            </DockPanel>

            <TextBlock x:Name="StatusText" Style="{StaticResource CaptionStyle}" Margin="0,8,0,0" />
            <TextBlock x:Name="EmptyState"
                       Style="{StaticResource BodySecondaryStyle}"
                       Margin="0,40,0,0"
                       HorizontalAlignment="Center"
                       Visibility="Collapsed"
                       Text="目前沒有圖片紀錄。" />
        </StackPanel>

        <ListBox x:Name="ItemsList"
                 Grid.Row="1"
                 Margin="0,16,0,0"
                 ItemContainerStyle="{StaticResource ClipboardCardListItemStyle}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.CanContentScroll="False">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorderStyle}" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Width="72"
                                        Height="72"
                                        CornerRadius="8"
                                        Margin="0,0,12,0"
                                        Background="{DynamicResource SurfaceAltBrush}"
                                        ClipToBounds="True">
                                    <Image Source="{Binding ThumbnailPath, Converter={StaticResource PathToImage}, ConverterParameter=96}"
                                           Stretch="Uniform" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="（圖片）"
                                               FontSize="13" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:MM-dd HH:mm}}"
                                                   Style="{StaticResource CaptionStyle}" />
                                        <TextBlock x:Name="PinnedLabel"
                                                   Text="已釘選"
                                                   Style="{StaticResource CaptionStyle}"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   Margin="10,0,0,0"
                                                   Visibility="Collapsed" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="複製" Style="{StaticResource IconButtonStyle}" Click="OnCopyClick" />
                                    <Button x:Name="AddToCaptureButton"
                                            Content="{x:Static strings:AppStrings.ActionAddToCapture}"
                                            ToolTipService.ToolTip="{x:Static strings:AppStrings.ActionAddToCaptureToolTip}"
                                            AutomationProperties.Name="{x:Static strings:AppStrings.ActionAddToCaptureToolTip}"
                                            Style="{StaticResource IconButtonStyle}"
                                            Click="OnAddToCaptureClick" />
                                    <Button x:Name="PinButton" Content="釘選" Style="{StaticResource IconButtonStyle}" Click="OnPinClick" />
                                    <Button Content="刪除" Style="{StaticResource IconButtonStyle}" Click="OnDeleteClick" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                <Setter TargetName="PinnedLabel" Property="Visibility" Value="Visible" />
                                <Setter TargetName="PinButton" Property="Content" Value="取消釘選" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>

