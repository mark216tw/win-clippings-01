<Window x:Class="Clippings.App.Views.RenameWorkspaceTabDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:strings="clr-namespace:Clippings.App.Strings"
        Title="{x:Static strings:AppStrings.WorkspaceRenameTab}"
        Width="400"
        MinWidth="320"
        MinHeight="180"
        SizeToContent="Height"
        ResizeMode="NoResize"
        Background="{DynamicResource AppBackgroundBrush}"
        Icon="/Assets/clippings.ico"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Loaded="OnLoaded">
    <StackPanel Margin="24">
        <Label Content="{x:Static strings:AppStrings.WorkspaceTabName}"
               Target="{Binding ElementName=NameInput}"
               Padding="0,0,0,8" />
        <TextBox x:Name="NameInput"
                 AutomationProperties.Name="{x:Static strings:AppStrings.WorkspaceTabName}"
                 TextChanged="OnNameChanged" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="{x:Static strings:AppStrings.ActionCancel}"
                    AutomationProperties.Name="{x:Static strings:AppStrings.ActionCancel}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    IsCancel="True"
                    Margin="0,0,8,0" />
            <Button x:Name="ConfirmButton"
                    Content="{x:Static strings:AppStrings.ActionConfirm}"
                    AutomationProperties.Name="{x:Static strings:AppStrings.ActionConfirm}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    IsDefault="True"
                    Click="OnConfirmClick" />
        </StackPanel>
    </StackPanel>
</Window>
