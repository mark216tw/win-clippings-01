<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DrawingImage x:Key="ClippingsMarkImage">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#4A86FF" Offset="0" />
                            <GradientStop Color="#1F55CC" Offset="1" />
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,32,32" RadiusX="7" RadiusY="7" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!-- Back blade (upper-left ring to lower-right tip) -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#D6E4FF" Thickness="2.6" StartLineCap="Round" EndLineCap="Round" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <LineGeometry StartPoint="12.2,12.8" EndPoint="25.2,22.8" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!-- Front blade (lower-left ring to upper-right tip) -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FFFFFF" Thickness="2.7" StartLineCap="Round" EndLineCap="Round" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <LineGeometry StartPoint="12.2,19.2" EndPoint="25.2,9.2" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!-- Handle rings -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FFFFFF" Thickness="2.4" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry Center="9.5,10.0" RadiusX="3.5" RadiusY="3.5" />
                            <EllipseGeometry Center="9.5,22.0" RadiusX="3.5" RadiusY="3.5" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!-- Pivot screw -->
                <GeometryDrawing Brush="#FFC857">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="16.4,16.0" RadiusX="1.45" RadiusY="1.45" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

</ResourceDictionary>
